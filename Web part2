html{
    scroll-behavior:smooth
}

body{
    font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    font-size: 16px;
    line-height: 1.5em;
    color:rgb(226, 226, 152);
    background-color:palegoldenrod;
}

/*Typography*/
h1,h2,h3,h4,h5,h6,h7,h8,h9,h9{
    font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    line-height: 1.2em;
    margin: 0 0 0.75em 0;
    color:rgb(42, 42, 85)
}

h1{
    font-size: 2rem;
    font-weight:700;
}

h2{
    font-size: 1.9em;
    font-weight:600;
}

h3{
    font-size: 1.8em;
    font-weight:500;
}

h4{
    font-size: 1.6em;
    font-weight:300;
}

h5{
    font-size: 1.6em;
    font-weight:300;
}

h6{
    font-size: 1.6em;
    font-weight:300;

}

h7{
    font-size: 1.6em;
    font-weight:300;

}

h8{
    font-size: 1.6em;
    font-weight:300;
}

h9{
    font-size: 1.6em;
    font-weight:300;
}

p{
    margin: 0 0 1rem 0;
}
/*Links & Pseudo-classes*/
a{
    color:grey;
    text-decoration:none;
}
a:hover{
    text-decoration:underline;
}

a:visited{
    color:powderblue
}

/*images*/
img{
    max-width:100%;
    height:auto;
    display:flex;
}

/*Buttons*/
button{
    display:inline-block;
    padding: 0.8rem 1.6rem;
    border: 2px solid transparent;
    border-radius: 999px;
    cursor: pointer;
}
    

/*Header and Navigation*/
.site-header{
    background-color:rgb(84, 51, 21);
    position:sticky;
    top:0;
    z-index:1000;
}
.header-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0.8rem 0;
    gap:1rem;
}

.logo{
    display:flex;
    align-items:center;
    gap: 0.6em;
    font-size: 1.5em;
    font-weight:700;
}

nav{
    display:flex;
    list-style-type: style none;
    gap:1.5rem;
    align-items:centre;
}

nav a{
    font-weight:600;
    padding:0.4rem 0.2rem;
    border-bottom:2px solid transparent;
    
}

nav a:hover,
nav a:focus,
nav a:active {
    border: bottom 3px solid rgb(26, 26, 6);
    text-decoration: none;
    
}

nav a:li:first-child a{
    padding-left: 0;
}

nav a:li:not(:last-child) a{
    border-right:1px solid rgb(102,102,32);
    padding-right:1.5rem;

}

.card{
    background-color:rgb(71, 127, 145);
    padding:1.5rem;
    border-radius: 50px;
    box-shadow:0 4px 6px rgba(68, 49, 49, 0.1);
    transition:trasform 0.3s ease, box-shadow 0.3s ease;
}

/*Responsive Design*/

/* Tablet*/
@Media (max-width:768px){
    .hero-grid{
        grid-template-columns: 1fr;
        text-align:center;
    
}
.card-grid{
    grid-template-columns:repeat(2, 1fr);

}
   }

   /* Mobile*/
   @Media (max-width:480px){
    .card-grid{
        grid-template-columns:1fr;
    }
   }
   
